<?xml version="1.0" encoding="UTF-8"?>
<!--
    Synthétique Prisme — Watch Face Format (WFF 2.0)
    Style Aventure/Concentrique, fond noir, analogique hybride
    Canvas 450×450 px, clip circulaire
-->
<WatchFace width="450" height="450" clipShape="CIRCLE" minSdkVersion="2">

    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">

        <!-- ════════════════════════════════════════════════════
             DATE — centré en haut (Jour Nº Mois)
             Visible en mode interactif ET ambient (légèrement dim)
             ════════════════════════════════════════════════════ -->
        <PartText name="date_text"
            x="125" y="50" width="200" height="36"
            alpha="255">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="16" color="#FFB0BEC5" weight="NORMAL">
                    <Template>%s %d %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_OF_MONTH]" /><Parameter expression="[MONTH_OF_YEAR_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ════════════════════════════════════════════════════
             ARC BATTERIE — côté gauche (195° → 345°, 150° sweep)
             Rayon 217, épaisseur 7px
             ════════════════════════════════════════════════════ -->

        <!-- Track de fond (toujours visible) -->
        <PartDraw name="battery_track"
            x="0" y="0" width="450" height="450"
            alpha="255">
            <Draw>
                <Arc centerX="225" centerY="225"
                    width="434" height="434"
                    startAngle="195" endAngle="345"
                    direction="CLOCKWISE"
                    strokeWidth="7" color="#FF1A2A3A" cap="ROUND" />
            </Draw>
        </PartDraw>

        <!-- Fill dynamique (interactif uniquement) -->
        <PartDraw name="battery_fill"
            x="0" y="0" width="450" height="450"
            alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Draw>
                <Arc centerX="225" centerY="225"
                    width="434" height="434"
                    startAngle="195"
                    endAngle="(195.0 + 150.0 * [BATTERY_PERCENT] / 100.0)"
                    direction="CLOCKWISE"
                    strokeWidth="7" color="#FF00E5FF" cap="ROUND" />
            </Draw>
        </PartDraw>

        <!-- Label pourcentage batterie (interactif uniquement) -->
        <PartText name="battery_label"
            x="18" y="207" width="60" height="22"
            alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" color="#FF78909C" weight="NORMAL">
                    <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ════════════════════════════════════════════════════
             ARC PAS — côté droit (15° → 165°, 150° sweep)
             Objectif : 10 000 pas / jour
             ════════════════════════════════════════════════════ -->

        <!-- Track de fond (toujours visible) -->
        <PartDraw name="steps_track"
            x="0" y="0" width="450" height="450"
            alpha="255">
            <Draw>
                <Arc centerX="225" centerY="225"
                    width="434" height="434"
                    startAngle="15" endAngle="165"
                    direction="CLOCKWISE"
                    strokeWidth="7" color="#FF1A2A3A" cap="ROUND" />
            </Draw>
        </PartDraw>

        <!-- Fill dynamique (interactif uniquement) -->
        <PartDraw name="steps_fill"
            x="0" y="0" width="450" height="450"
            alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Draw>
                <Arc centerX="225" centerY="225"
                    width="434" height="434"
                    startAngle="15"
                    endAngle="(15.0 + min(150.0, 150.0 * [STEP_COUNT] / 10000.0))"
                    direction="CLOCKWISE"
                    strokeWidth="7" color="#FF81C784" cap="ROUND" />
            </Draw>
        </PartDraw>

        <!-- Label nombre de pas (interactif uniquement) -->
        <PartText name="steps_label"
            x="372" y="207" width="65" height="22"
            alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" color="#FF78909C" weight="NORMAL">
                    <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ════════════════════════════════════════════════════
             REPÈRES HORAIRES — 12h et 6h (en dehors des arcs)
             Rectangles 8×18 px, gris ardoise
             ════════════════════════════════════════════════════ -->
        <PartDraw name="tick_12h"
            x="221" y="18" width="8" height="18"
            alpha="180">
            <Draw>
                <Rectangle x="0" y="0" width="8" height="18" color="#FF607D8B" />
            </Draw>
        </PartDraw>

        <PartDraw name="tick_6h"
            x="221" y="414" width="8" height="18"
            alpha="180">
            <Draw>
                <Rectangle x="0" y="0" width="8" height="18" color="#FF607D8B" />
            </Draw>
        </PartDraw>

        <!-- ════════════════════════════════════════════════════
             AIGUILLES ANALOGIQUES
             Pivot toutes en (225, 225) — calcul :
               x + pivotX * w = 225
               y + pivotY * h = 225
             ════════════════════════════════════════════════════ -->
        <AnalogClock name="main_clock"
            x="0" y="0" width="450" height="450">

            <!--
                HEURES : 100 px au-dessus du centre, 18 px en dessous
                bbox : x=219, y=125, w=12, h=118
                pivotX=0.5  → 219 + 0.5×12 = 225 ✓
                pivotY=0.847 → 125 + 0.847×118 ≈ 225 ✓
            -->
            <HourHand x="219" y="125" width="12" height="118"
                pivotX="0.5" pivotY="0.847">
                <Draw>
                    <RoundRect x="2" y="0" width="8" height="100"
                        rx="4" color="#FFFFFFFF" />
                </Draw>
            </HourHand>

            <!--
                MINUTES : 145 px au-dessus, 18 px en dessous
                bbox : x=221, y=80, w=8, h=163
                pivotX=0.5  → 221 + 4 = 225 ✓
                pivotY=0.890 → 80 + 0.890×163 ≈ 225 ✓
            -->
            <MinuteHand x="221" y="80" width="8" height="163"
                pivotX="0.5" pivotY="0.890">
                <Draw>
                    <RoundRect x="1" y="0" width="6" height="145"
                        rx="3" color="#FFFFFFFF" />
                </Draw>
            </MinuteHand>

            <!--
                SECONDES : 165 px au-dessus, 35 px en dessous (contrepoids)
                bbox : x=222, y=60, w=6, h=200
                pivotX=0.5  → 222 + 3 = 225 ✓
                pivotY=0.825 → 60 + 0.825×200 = 225 ✓
                Masquée en mode Ambient
            -->
            <SecondHand x="222" y="60" width="6" height="200"
                pivotX="0.5" pivotY="0.825"
                alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Draw>
                    <!-- Tige principale (s'arrête 10 px avant le centre) -->
                    <Rectangle x="2" y="0" width="2" height="155"
                        color="#FFFF5252" />
                    <!-- Contrepoids (commence 10 px après le centre) -->
                    <Rectangle x="2" y="175" width="2" height="22"
                        color="#FFFF4444" />
                </Draw>
            </SecondHand>

        </AnalogClock>

        <!-- ════════════════════════════════════════════════════
             HUB CENTRAL — par-dessus les aiguilles
             Cercles concentriques : blanc → noir → rouge
             bbox 30×30 centré en (225,225) → x=210, y=210
             ════════════════════════════════════════════════════ -->
        <PartDraw name="center_hub"
            x="210" y="210" width="30" height="30"
            alpha="255">
            <Draw>
                <Circle centerX="15" centerY="15" radius="9"  color="#FFFFFFFF" />
                <Circle centerX="15" centerY="15" radius="5"  color="#FF000000" />
                <Circle centerX="15" centerY="15" radius="3"  color="#FFFF5252" />
            </Draw>
        </PartDraw>

        <!-- ════════════════════════════════════════════════════
             SECONDES NUMÉRIQUES — juste sous le centre
             Format : 00–59, interactif uniquement
             ════════════════════════════════════════════════════ -->
        <PartText name="digital_seconds"
            x="175" y="258" width="100" height="26"
            alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" color="#FF546E7A" weight="LIGHT">
                    <Template><Parameter expression="[SECONDS_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

    </Scene>

</WatchFace>
